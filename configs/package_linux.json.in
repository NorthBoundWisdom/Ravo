{
  "app": {
    "name": "ravo_studio",
    "displayName": "Ravo Studio",
    "version": "@PROJECT_VERSION@"
  },
  "paths": {
    "sourceDir": "@CMAKE_SOURCE_DIR@",
    "binaryDir": "@CMAKE_BINARY_DIR@",
    "targetPath": "@CMAKE_CURRENT_BINARY_DIR@/desktop/ravo_studio",
    "distDir": "@RAVO_PACKAGE_DIST_ROOT@/@RAVO_PACKAGE_DIST_NAME@"
  },
  "qt": {
    "binDir": "@RAVO_PACKAGE_QT_BIN_DIR@",
    "qmlDir": "@RAVO_PACKAGE_QML_DIR@"
  },
  "resources": {
    "copyFiles": [
      {
        "source": "@CMAKE_CURRENT_BINARY_DIR@/cli/ravo",
        "destinationDir": "."
      },
      {
        "source": "@CMAKE_SOURCE_DIR@/LICENSE",
        "destinationDir": "."
      },
      {
        "source": "@CMAKE_SOURCE_DIR@/THIRD_PARTY_NOTICES.md",
        "destinationDir": "."
      }
    ]
  },
  "linux": {
    "packageName": "@RAVO_PACKAGE_ARTIFACT_STEM@",
    "iconFile": "@CMAKE_CURRENT_SOURCE_DIR@/desktop/icons/AppIcon.png",
    "desktop": {
      "categories": "Graphics;Photography;"
    },
    "extraLibraries": @RAVO_PACKAGE_LINUX_RUNTIME_LIBRARIES_JSON@,
    "debugPackage": false,
    "appImageTool": "@RAVO_PACKAGE_APPIMAGE_TOOL@",
    "debTool": "@RAVO_PACKAGE_DEB_TOOL@",
    "debOutputPath": "@RAVO_PACKAGE_DEB_OUTPUT@",
    "debPackageName": "ravostudio",
    "debArchitecture": "@RAVO_PACKAGE_DEB_ARCHITECTURE@",
    "debMaintainer": "Ravo Maintainers <northboundwisdom@users.noreply.github.com>",
    "debDescription": "Ravo Studio photo catalog and image viewer",
    "debSection": "graphics",
    "debPriority": "optional",
    "debDependencies": "libc6, libgcc-s1, libstdc++6",
    "debInstallPrefix": "/opt/RavoStudio",
    "debExecutables": [
      "ravo_studio",
      "ravo"
    ]
  }
}
