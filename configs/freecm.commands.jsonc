{
  "version": 2,
  "commands": {
    "config": [
      {
        "id": "win-msvc-debug",
        "label": "Win MSVC Debug",
        "description": "Configure the win_msvc_debug CMake preset with tests enabled",
        "command": "cmake",
        "args": ["--preset", "win_msvc_debug", "-DBUILD_TESTING=ON"],
        "platforms": ["win32"],
        "default": true,
        "defaults": {
          "build": "win-msvc-debug",
          "run": "win-msvc-debug-app",
          "test": "win-msvc-debug-tests"
        },
        "readiness": {
          "inputs": ["CMakeLists.txt", "CMakePresets.json", "source_roots.lock.jsonc"],
          "outputs": ["build/win_msvc_debug/CMakeCache.txt"]
        }
      },
      {
        "id": "win-msvc-release",
        "label": "Win MSVC Release",
        "description": "Configure the win_msvc_release CMake preset",
        "command": "cmake",
        "args": ["--preset", "win_msvc_release"],
        "platforms": ["win32"],
        "defaults": {
          "build": "win-msvc-release",
          "run": "win-msvc-release-app",
          "package": "win-msvc-release-install"
        },
        "readiness": {
          "inputs": ["CMakeLists.txt", "CMakePresets.json", "source_roots.lock.jsonc"],
          "outputs": ["build/win_msvc_release/CMakeCache.txt"]
        }
      },
      {
        "id": "mac-clang-debug",
        "label": "Mac Clang Debug",
        "description": "Configure the mac_clang_debug CMake preset with tests enabled",
        "command": "cmake",
        "args": ["--preset", "mac_clang_debug", "-DBUILD_TESTING=ON"],
        "platforms": ["darwin"],
        "default": true,
        "defaults": {
          "build": "mac-clang-debug",
          "run": "mac-clang-debug-app",
          "test": "mac-clang-debug-tests"
        },
        "readiness": {
          "inputs": ["CMakeLists.txt", "CMakePresets.json", "source_roots.lock.jsonc"],
          "outputs": ["build/mac_clang_debug/CMakeCache.txt"]
        }
      },
      {
        "id": "mac-clang-release",
        "label": "Mac Clang Release",
        "description": "Configure the mac_clang_release CMake preset",
        "command": "cmake",
        "args": ["--preset", "mac_clang_release"],
        "platforms": ["darwin"],
        "defaults": {
          "build": "mac-clang-release",
          "run": "mac-clang-release-app",
          "package": "mac-clang-release-install"
        },
        "readiness": {
          "inputs": ["CMakeLists.txt", "CMakePresets.json", "source_roots.lock.jsonc"],
          "outputs": ["build/mac_clang_release/CMakeCache.txt"]
        }
      },
      {
        "id": "linux-clang-debug",
        "label": "Linux Clang Debug",
        "description": "Configure the linux_clang_debug CMake preset with tests enabled",
        "command": "cmake",
        "args": ["--preset", "linux_clang_debug", "-DBUILD_TESTING=ON"],
        "platforms": ["linux"],
        "default": true,
        "defaults": {
          "build": "linux-clang-debug",
          "run": "linux-clang-debug-app",
          "test": "linux-clang-debug-tests"
        },
        "readiness": {
          "inputs": ["CMakeLists.txt", "CMakePresets.json", "source_roots.lock.jsonc"],
          "outputs": ["build/linux_clang_debug/CMakeCache.txt"]
        }
      },
      {
        "id": "linux-clang-release",
        "label": "Linux Clang Release",
        "description": "Configure the linux_clang_release CMake preset",
        "command": "cmake",
        "args": ["--preset", "linux_clang_release"],
        "platforms": ["linux"],
        "defaults": {
          "build": "linux-clang-release",
          "run": "linux-clang-release-app",
          "package": "linux-clang-release-install"
        },
        "readiness": {
          "inputs": ["CMakeLists.txt", "CMakePresets.json", "source_roots.lock.jsonc"],
          "outputs": ["build/linux_clang_release/CMakeCache.txt"]
        }
      }
    ],
    "build": [
      {
        "id": "win-msvc-debug",
        "label": "Win MSVC Debug",
        "description": "Build the win_msvc_debug CMake preset",
        "command": "cmake",
        "args": ["--build", "--preset", "win_msvc_debug"],
        "configurations": ["win-msvc-debug"]
      },
      {
        "id": "win-msvc-release",
        "label": "Win MSVC Release",
        "description": "Build the win_msvc_release CMake preset",
        "command": "cmake",
        "args": ["--build", "--preset", "win_msvc_release"],
        "configurations": ["win-msvc-release"]
      },
      {
        "id": "mac-clang-debug",
        "label": "Mac Clang Debug",
        "description": "Build the mac_clang_debug CMake preset",
        "command": "cmake",
        "args": ["--build", "--preset", "mac_clang_debug"],
        "configurations": ["mac-clang-debug"]
      },
      {
        "id": "mac-clang-release",
        "label": "Mac Clang Release",
        "description": "Build the mac_clang_release CMake preset",
        "command": "cmake",
        "args": ["--build", "--preset", "mac_clang_release"],
        "configurations": ["mac-clang-release"]
      },
      {
        "id": "linux-clang-debug",
        "label": "Linux Clang Debug",
        "description": "Build the linux_clang_debug CMake preset",
        "command": "cmake",
        "args": ["--build", "--preset", "linux_clang_debug"],
        "configurations": ["linux-clang-debug"]
      },
      {
        "id": "linux-clang-release",
        "label": "Linux Clang Release",
        "description": "Build the linux_clang_release CMake preset",
        "command": "cmake",
        "args": ["--build", "--preset", "linux_clang_release"],
        "configurations": ["linux-clang-release"]
      }
    ],
    "run": [
      {
        "id": "win-msvc-debug-app",
        "label": "Win MSVC Debug App",
        "description": "Build and run Ravo Studio in the FreeCM terminal",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "win_msvc_debug", "--target", "ravo_studio"]
          },
          {
            "command": "./build/win_msvc_debug/Ravo/desktop/ravo_studio.exe",
            "args": []
          }
        ],
        "configurations": ["win-msvc-debug"]
      },
      {
        "id": "win-msvc-release-app",
        "label": "Win MSVC Release App",
        "description": "Build and run Ravo Studio in the FreeCM terminal",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "win_msvc_release", "--target", "ravo_studio"]
          },
          {
            "command": "./build/win_msvc_release/Ravo/desktop/ravo_studio.exe",
            "args": []
          }
        ],
        "configurations": ["win-msvc-release"]
      },
      {
        "id": "mac-clang-debug-app",
        "label": "Mac Clang Debug App",
        "description": "Build and run Ravo Studio in the FreeCM terminal",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "mac_clang_debug", "--target", "ravo_studio"]
          },
          {
            "command": "./build/mac_clang_debug/Ravo/desktop/ravo_studio.app/Contents/MacOS/ravo_studio",
            "args": []
          }
        ],
        "configurations": ["mac-clang-debug"]
      },
      {
        "id": "mac-clang-release-app",
        "label": "Mac Clang Release App",
        "description": "Build and run Ravo Studio in the FreeCM terminal",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "mac_clang_release", "--target", "ravo_studio"]
          },
          {
            "command": "./build/mac_clang_release/Ravo/desktop/ravo_studio.app/Contents/MacOS/ravo_studio",
            "args": []
          }
        ],
        "configurations": ["mac-clang-release"]
      },
      {
        "id": "linux-clang-debug-app",
        "label": "Linux Clang Debug App",
        "description": "Build and run Ravo Studio in the FreeCM terminal",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "linux_clang_debug", "--target", "ravo_studio"]
          },
          {
            "command": "./build/linux_clang_debug/Ravo/desktop/ravo_studio",
            "args": []
          }
        ],
        "configurations": ["linux-clang-debug"]
      },
      {
        "id": "linux-clang-release-app",
        "label": "Linux Clang Release App",
        "description": "Build and run Ravo Studio in the FreeCM terminal",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "linux_clang_release", "--target", "ravo_studio"]
          },
          {
            "command": "./build/linux_clang_release/Ravo/desktop/ravo_studio",
            "args": []
          }
        ],
        "configurations": ["linux-clang-release"]
      }
    ],
    "test": [
      {
        "id": "win-msvc-debug-tests",
        "label": "Win MSVC Debug Tests",
        "description": "Build and run Ravo unit and contract tests",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "win_msvc_debug"]
          },
          {
            "command": "ctest",
            "args": ["--test-dir", "build/win_msvc_debug", "--output-on-failure"]
          }
        ],
        "configurations": ["win-msvc-debug"]
      },
      {
        "id": "mac-clang-debug-tests",
        "label": "Mac Clang Debug Tests",
        "description": "Build and run Ravo unit and contract tests",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "mac_clang_debug"]
          },
          {
            "command": "ctest",
            "args": ["--test-dir", "build/mac_clang_debug", "--output-on-failure"]
          }
        ],
        "configurations": ["mac-clang-debug"]
      },
      {
        "id": "linux-clang-debug-tests",
        "label": "Linux Clang Debug Tests",
        "description": "Build and run Ravo unit and contract tests",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "linux_clang_debug"]
          },
          {
            "command": "ctest",
            "args": ["--test-dir", "build/linux_clang_debug", "--output-on-failure"]
          }
        ],
        "configurations": ["linux-clang-debug"]
      }
    ],
    "package": [
      {
        "id": "win-msvc-release-install",
        "label": "Win MSVC Release Install",
        "description": "Build and stage the Ravo release CLI and Studio",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "win_msvc_release"]
          },
          {
            "command": "cmake",
            "args": ["--install", "build/win_msvc_release", "--prefix", "install/win_msvc_release"]
          }
        ],
        "configurations": ["win-msvc-release"]
      },
      {
        "id": "mac-clang-release-install",
        "label": "Mac Clang Release Install",
        "description": "Build and stage the Ravo release CLI and Studio",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "mac_clang_release"]
          },
          {
            "command": "cmake",
            "args": ["--install", "build/mac_clang_release", "--prefix", "install/mac_clang_release"]
          }
        ],
        "configurations": ["mac-clang-release"]
      },
      {
        "id": "linux-clang-release-install",
        "label": "Linux Clang Release Install",
        "description": "Build and stage the Ravo release CLI and Studio",
        "steps": [
          {
            "command": "cmake",
            "args": ["--build", "--preset", "linux_clang_release"]
          },
          {
            "command": "cmake",
            "args": ["--install", "build/linux_clang_release", "--prefix", "install/linux_clang_release"]
          }
        ],
        "configurations": ["linux-clang-release"]
      }
    ]
  }
}
