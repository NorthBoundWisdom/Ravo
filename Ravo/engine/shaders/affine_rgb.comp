#version 440
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Values {
    float values[];
};

layout(std140, binding = 1) uniform Params {
    uvec4 header;
    vec4 body;
};

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index >= header.x)
        return;
    values[index] = (values[index] - body.y) * body.x;
}
