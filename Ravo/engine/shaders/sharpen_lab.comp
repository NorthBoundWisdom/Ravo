#version 440
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Rgb {
    float rgb[];
};

layout(std430, binding = 1) buffer Lab {
    float lab[];
};

layout(std430, binding = 2) buffer Blur {
    float blur[];
};

layout(std140, binding = 3) uniform Params {
    uvec4 header;
    vec4 body;
    vec4 kernel[7];
};

uint width()
{
    return header.x;
}

uint height()
{
    return header.y;
}

uint radius()
{
    return header.z;
}

uint stage()
{
    return header.w;
}

float amount()
{
    return body.x;
}

float threshold()
{
    return body.y;
}

float kernel_at(uint index)
{
    return kernel[index / 4u][index % 4u];
}

vec3 linear_rec709_to_xyz(vec3 rgb_pixel)
{
    return vec3(0.4360747 * rgb_pixel.r + 0.3850649 * rgb_pixel.g + 0.1430804 * rgb_pixel.b,
                0.2225045 * rgb_pixel.r + 0.7168786 * rgb_pixel.g + 0.0606169 * rgb_pixel.b,
                0.0139322 * rgb_pixel.r + 0.0971045 * rgb_pixel.g + 0.7141733 * rgb_pixel.b);
}

vec3 xyz_to_linear_rec709(vec3 xyz)
{
    return vec3(3.1338561 * xyz.x + (-1.6168667) * xyz.y + (-0.4906146) * xyz.z,
                (-0.9787684) * xyz.x + 1.9161415 * xyz.y + 0.0334540 * xyz.z,
                0.0719453 * xyz.x + (-0.2289914) * xyz.y + 1.4052427 * xyz.z);
}

float lab_pivot(float normalized)
{
    const float epsilon = 216.0 / 24389.0;
    const float kappa = 24389.0 / 27.0;
    return normalized > epsilon ? pow(normalized, 1.0 / 3.0) : (kappa * normalized + 16.0) / 116.0;
}

vec3 xyz_to_lab(vec3 xyz)
{
    const vec3 d50_inverse = vec3(1.0 / 0.9642, 1.0, 1.0 / 0.8249);
    const vec3 transformed = vec3(lab_pivot(xyz.x * d50_inverse.x), lab_pivot(xyz.y * d50_inverse.y),
                                  lab_pivot(xyz.z * d50_inverse.z));
    return vec3(116.0 * transformed.y - 16.0, 500.0 * (transformed.x - transformed.y),
                -200.0 * (transformed.z - transformed.y));
}

float lab_inverse_pivot(float value)
{
    const float epsilon = 0.20689655172413796;
    const float kappa = 24389.0 / 27.0;
    return value > epsilon ? value * value * value : (116.0 * value - 16.0) / kappa;
}

vec3 lab_to_xyz(vec3 lab_pixel)
{
    const vec3 d50 = vec3(0.9642, 1.0, 0.8249);
    const float fy = (lab_pixel.x + 16.0) / 116.0;
    const float fx = fy + lab_pixel.y / 500.0;
    const float fz = fy - lab_pixel.z / 200.0;
    return vec3(d50.x * lab_inverse_pivot(fx), d50.y * lab_inverse_pivot(fy),
                d50.z * lab_inverse_pivot(fz));
}

void convert_rgb_to_lab(uint pixel)
{
    const uint base = pixel * 3u;
    const vec3 rgb_pixel = vec3(rgb[base], rgb[base + 1u], rgb[base + 2u]);
    const vec3 lab_pixel = xyz_to_lab(linear_rec709_to_xyz(rgb_pixel));
    lab[base] = lab_pixel.x;
    lab[base + 1u] = lab_pixel.y;
    lab[base + 2u] = lab_pixel.z;
}

void convert_lab_to_rgb(uint pixel)
{
    const uint base = pixel * 3u;
    const vec3 lab_pixel = vec3(lab[base], lab[base + 1u], lab[base + 2u]);
    const vec3 rgb_pixel = xyz_to_linear_rec709(lab_to_xyz(lab_pixel));
    rgb[base] = rgb_pixel.x;
    rgb[base + 1u] = rgb_pixel.y;
    rgb[base + 2u] = rgb_pixel.z;
}

void blur_vertical(uint pixel, uint x, uint y)
{
    const uint border = radius();
    if (y < border || y >= height() - border)
        return;
    const int start_row = int(y) - int(border);
    float sum = 0.0;
    for (uint kernel_index = 0u; kernel_index <= border * 2u; ++kernel_index)
    {
        const uint source_row = uint(start_row) + kernel_index;
        sum += kernel_at(kernel_index) * lab[(source_row * width() + x) * 3u];
    }
    blur[pixel] = sum;
}

void usm_horizontal(uint pixel, uint x, uint y)
{
    const uint border = radius();
    if (y < border || y >= height() - border || x < border || x >= width() - border)
        return;
    const int start_column = int(x) - int(border);
    float sum = 0.0;
    for (uint kernel_index = 0u; kernel_index <= border * 2u; ++kernel_index)
    {
        const uint source_column = uint(start_column) + kernel_index;
        sum += kernel_at(kernel_index) * blur[y * width() + source_column];
    }
    const float lightness = lab[pixel * 3u];
    const float difference = lightness - sum;
    const float absolute = abs(difference);
    const float detail =
        absolute > threshold() ? sign(difference) * max(absolute - threshold(), 0.0) : 0.0;
    lab[pixel * 3u] = lightness + detail * amount();
}

void main()
{
    const uint pixel = gl_GlobalInvocationID.x;
    const uint count = width() * height();
    if (pixel >= count || width() == 0u)
        return;
    const uint x = pixel % width();
    const uint y = pixel / width();
    if (stage() == 0u)
        convert_rgb_to_lab(pixel);
    else if (stage() == 1u)
        blur_vertical(pixel, x, y);
    else if (stage() == 2u)
        usm_horizontal(pixel, x, y);
    else
        convert_lab_to_rgb(pixel);
}
