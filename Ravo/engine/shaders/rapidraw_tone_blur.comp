// Adapted from RapidRAW commit d6d8daa999f81198fb49e99b7e8ff43b47a6ffcd,
// src-tauri/src/shaders/blur.wgsl. Copyright Timon Käch and RapidRAW
// contributors. SPDX-License-Identifier: AGPL-3.0-only

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Rgb {
    float rgb[];
};

layout(std430, binding = 1) buffer Horizontal {
    float horizontal[];
};

layout(std140, binding = 2) uniform Params {
    uvec4 shape;
    vec4 primary;
    vec4 tonal;
};

float gaussian(float x, float sigma)
{
    return exp(-(x * x) / (2.0 * sigma * sigma));
}

void main()
{
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= shape.z)
        return;
    uint x = pixel % shape.x;
    uint y = pixel / shape.x;
    int radius = int(shape.w);
    float sigma = float(radius) / 2.0;
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int offset = -radius; offset <= radius; ++offset)
    {
        int sx = clamp(int(x) + offset, 0, int(shape.x) - 1);
        uint base = (y * shape.x + uint(sx)) * 3u;
        float weight = gaussian(float(offset), sigma);
        sum += clamp(vec3(rgb[base], rgb[base + 1u], rgb[base + 2u]), vec3(0.0),
                     vec3(65504.0)) * weight;
        total += weight;
    }
    uint base = pixel * 3u;
    vec3 value = sum / total;
    horizontal[base] = value.r;
    horizontal[base + 1u] = value.g;
    horizontal[base + 2u] = value.b;
}
