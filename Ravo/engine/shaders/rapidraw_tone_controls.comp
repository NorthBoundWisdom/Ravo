layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Rgb {
    float rgb[];
};

layout(std430, binding = 1) readonly buffer Source {
    float source_rgb[];
};

layout(std140, binding = 2) uniform Params {
    uvec4 shape;
    vec4 primary;
    vec4 tonal;
};

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float luma(vec3 value)
{
    return dot(value, LUMA);
}

float gaussian(float x, float sigma)
{
    return exp(-(x * x) / (2.0 * sigma * sigma));
}

vec3 tonal_blur(uint x, uint y)
{
    int radius = int(shape.w);
    float sigma = float(radius) / 2.0;
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int offset = -radius; offset <= radius; ++offset)
    {
        int sy = clamp(int(y) + offset, 0, int(shape.y) - 1);
        float weight = gaussian(float(offset), sigma);
        uint base = (uint(sy) * shape.x + x) * 3u;
        sum += clamp(vec3(source_rgb[base], source_rgb[base + 1u], source_rgb[base + 2u]),
                     vec3(0.0), vec3(65504.0)) * weight;
        total += weight;
    }
    return sum / total;
}

vec3 filmic_exposure(vec3 value, float brightness)
{
    if (brightness == 0.0)
        return value;
    float original_luma = luma(value);
    if (abs(original_luma) < 0.00001)
        return value;
    const float rational_mix = 0.95;
    const float midtone_strength = 1.2;
    const float top_anchor = 1.06;
    float scale = exp2(brightness * (1.0 - rational_mix));
    float k = exp2(-brightness * rational_mix * midtone_strength);
    float absolute_luma = abs(original_luma);
    float floor_luma = floor(absolute_luma / top_anchor) * top_anchor;
    float normalized = (absolute_luma - floor_luma) / top_anchor;
    float shaped = normalized / (normalized + (1.0 - normalized) * k);
    float new_luma = sign(original_luma) * (floor_luma + shaped * top_anchor) * scale;
    vec3 chroma = value - vec3(original_luma);
    float total_scale = new_luma / original_luma;
    float exponent = mix(0.95, 0.65, clamp(new_luma, 0.0, 2.0) * 0.5);
    float chroma_scale = pow(total_scale, exponent) /
                         (1.0 + max(0.0, new_luma - 0.9) * 2.0);
    return vec3(new_luma) + chroma * chroma_scale;
}

vec3 tonal_adjustments(vec3 value, vec3 blurred, float contrast, float shadows,
                       float whites, float blacks)
{
    vec3 result = value;
    if (whites != 0.0)
    {
        float multiplier = 1.0 / max(1.0 - whites * 0.25, 0.01);
        result *= multiplier;
        blurred *= multiplier;
    }
    float pixel_luma = luma(max(result, vec3(0.0)));
    float blurred_luma = luma(max(blurred, vec3(0.0)));
    float safe_pixel_luma = max(pixel_luma, 0.0001);
    float safe_blurred_luma = max(blurred_luma, 0.0001);
    if (shadows != 0.0 || blacks != 0.0)
    {
        float pixel = pow(safe_pixel_luma, 0.4545);
        float blurred_value = pow(safe_blurred_luma, 0.4545);
        float shadow_lift = shadows * pixel * pow(max(1.0 - pixel, 0.0), 4.5);
        float black_lift = blacks * pixel * pow(max(1.0 - pixel, 0.0), 12.0);
        float lift = max(shadow_lift + black_lift, 0.0);
        float curved = max(pixel + shadow_lift + black_lift, 0.0);
        float contrasted = 0.2 + (curved - 0.2) * (1.0 + lift * 1.3);
        float final_value = max(mix(curved, contrasted, 0.85), 0.0);
        float ratio = pow(final_value, 2.2) / safe_pixel_luma;
        result *= ratio;
        float safe_detail = clamp(pixel / max(blurred_value, 0.0001), 0.8, 1.25);
        float exponent = 1.0 + lift * 1.2 * smoothstep(0.0, 0.1, blurred_value);
        result *= pow(pow(safe_detail, exponent) / safe_detail, 2.2);
        if (ratio > 1.0)
        {
            float recovered = luma(result);
            result = mix(result, vec3(recovered), clamp((ratio - 1.0) * 0.15, 0.0, 0.4));
        }
    }
    if (contrast != 0.0)
    {
        vec3 safe = max(result, vec3(0.0));
        vec3 perceptual = clamp(pow(safe, vec3(1.0 / 2.2)), vec3(0.0), vec3(1.0));
        float strength = exp2(contrast * 1.25);
        bvec3 low = lessThan(perceptual, vec3(0.5));
        vec3 high_part = vec3(1.0) - 0.5 * pow(2.0 * (vec3(1.0) - perceptual), vec3(strength));
        vec3 low_part = 0.5 * pow(2.0 * perceptual, vec3(strength));
        vec3 adjusted = pow(mix(high_part, low_part, low), vec3(2.2));
        result = mix(adjusted, result, smoothstep(vec3(1.0), vec3(1.01), safe));
    }
    return result;
}

vec3 highlights_adjustment(vec3 value, float highlights)
{
    if (highlights == 0.0)
        return value;
    float pixel_luma = luma(max(value, vec3(0.0)));
    float mask = smoothstep(0.3, 0.95, tanh(max(pixel_luma, 0.0001) * 1.5));
    if (mask < 0.001)
        return value;
    vec3 adjusted;
    if (highlights < 0.0)
    {
        float new_luma;
        if (pixel_luma <= 1.0)
            new_luma = pow(pixel_luma, 1.0 - highlights * 1.75);
        else
        {
            float excess = pixel_luma - 1.0;
            new_luma = 1.0 + excess / (1.0 + excess * (-highlights * 6.0));
        }
        adjusted = value * (new_luma / max(pixel_luma, 0.0001));
        adjusted = mix(adjusted, vec3(new_luma), smoothstep(1.0, 10.0, pixel_luma));
    }
    else
        adjusted = value * exp2(highlights * 1.75);
    return mix(value, adjusted, mask);
}

void main()
{
    uint pixel = gl_GlobalInvocationID.x;
    if (pixel >= shape.z)
        return;
    uint base = pixel * 3u;
    vec3 value = vec3(rgb[base], rgb[base + 1u], rgb[base + 2u]);
    value *= exp2(primary.x / 0.8);
    value = filmic_exposure(value, primary.y / 0.8);
    vec3 blurred = (primary.w != 0.0 || tonal.w != 0.0) ?
                       tonal_blur(pixel % shape.x, pixel / shape.x) : value;
    value = tonal_adjustments(value, blurred, primary.z / 100.0, primary.w / 120.0,
                              tonal.z / 30.0, tonal.w / 40.0);
    value = highlights_adjustment(value, tonal.x / 120.0);
    rgb[base] = value.r;
    rgb[base + 1u] = value.g;
    rgb[base + 2u] = value.b;
}
