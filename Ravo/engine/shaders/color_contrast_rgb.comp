#version 440
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Values {
    float values[];
};

layout(std140, binding = 1) uniform Params {
    uvec4 header;
    vec4 body;
};

// Match CPU apply_color_contrast: linear Rec.709 <-> D50 Lab, then a/b affine.
vec3 linear_rec709_to_xyz(vec3 rgb_pixel)
{
    return vec3(0.4360747 * rgb_pixel.r + 0.3850649 * rgb_pixel.g + 0.1430804 * rgb_pixel.b,
                0.2225045 * rgb_pixel.r + 0.7168786 * rgb_pixel.g + 0.0606169 * rgb_pixel.b,
                0.0139322 * rgb_pixel.r + 0.0971045 * rgb_pixel.g + 0.7141733 * rgb_pixel.b);
}

vec3 xyz_to_linear_rec709(vec3 xyz)
{
    return vec3(3.1338561 * xyz.x + (-1.6168667) * xyz.y + (-0.4906146) * xyz.z,
                (-0.9787684) * xyz.x + 1.9161415 * xyz.y + 0.0334540 * xyz.z,
                0.0719453 * xyz.x + (-0.2289914) * xyz.y + 1.4052427 * xyz.z);
}

float lab_pivot(float normalized)
{
    const float epsilon = 216.0 / 24389.0;
    const float kappa = 24389.0 / 27.0;
    return normalized > epsilon ? pow(normalized, 1.0 / 3.0) : (kappa * normalized + 16.0) / 116.0;
}

vec3 xyz_to_lab(vec3 xyz)
{
    const vec3 d50_inverse = vec3(1.0 / 0.9642, 1.0, 1.0 / 0.8249);
    const vec3 transformed = vec3(lab_pivot(xyz.x * d50_inverse.x), lab_pivot(xyz.y * d50_inverse.y),
                                  lab_pivot(xyz.z * d50_inverse.z));
    return vec3(116.0 * transformed.y - 16.0, 500.0 * (transformed.x - transformed.y),
                -200.0 * (transformed.z - transformed.y));
}

float lab_inverse_pivot(float value)
{
    const float epsilon = 0.20689655172413796;
    const float kappa = 24389.0 / 27.0;
    return value > epsilon ? value * value * value : (116.0 * value - 16.0) / kappa;
}

vec3 lab_to_xyz(vec3 lab_pixel)
{
    const vec3 d50 = vec3(0.9642, 1.0, 0.8249);
    const float fy = (lab_pixel.x + 16.0) / 116.0;
    const float fx = fy + lab_pixel.y / 500.0;
    const float fz = fy - lab_pixel.z / 200.0;
    return vec3(d50.x * lab_inverse_pivot(fx), d50.y * lab_inverse_pivot(fy),
                d50.z * lab_inverse_pivot(fz));
}

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index >= header.x)
        return;
    const uint base = index * 3u;
    const vec3 rgb_in = vec3(values[base], values[base + 1u], values[base + 2u]);
    vec3 lab = xyz_to_lab(linear_rec709_to_xyz(rgb_in));
    float a = lab.y * body.x + body.y;
    float b = lab.z * body.z + body.w;
    if (header.y == 0u)
    {
        a = clamp(a, -128.0, 128.0);
        b = clamp(b, -128.0, 128.0);
    }
    const vec3 rgb_out = xyz_to_linear_rec709(lab_to_xyz(vec3(lab.x, a, b)));
    values[base] = rgb_out.x;
    values[base + 1u] = rgb_out.y;
    values[base + 2u] = rgb_out.z;
}
