{
  // Direct third-party source roots consumed by the Ravo CMake graph.
  // FreeCM materializes the pinned commits locally; do not replace these with
  // submodules, vendored copies, or CMake-time downloads.
  "schemaVersion": 5,
  "AppConfigs": {
    "DevMode": false
  },
  "cmakeEnvironment": {},
  "cmakeCacheVariables": {
    // Copy these platform maps into the machine-local source_roots.lock.jsonc and
    // replace <user> plus the Qt kit version before Config. Do not leave <user> in
    // the active lock; CMake would treat it as a literal path. Package runtime
    // search roots must point at directories containing deployable dylib/DLL/SO
    // files. Package architecture names are release filename components; change
    // them when the selected kit targets another architecture. Linux package
    // tools may be command names on PATH or absolute paths. Run --update after
    // every active-lock change so the values reach the generated CMake presets.
    "mac": {
      "CMAKE_PREFIX_PATH": "/Users/<user>/vcpkg/installed/arm64-osx;/Users/<user>/vcpkg/installed/arm64-osx/debug;/Users/<user>/Qt/6.11.2/macos;/opt/homebrew;/opt/homebrew/opt/zlib",
      "RAVO_PACKAGE_RUNTIME_SEARCH_PATHS": "/Users/<user>/vcpkg/installed/arm64-osx/lib;/Users/<user>/vcpkg/installed/arm64-osx/debug/lib;/Users/<user>/Qt/6.11.2/macos/lib;/opt/homebrew/lib;/opt/homebrew/opt/zlib/lib",
      "RAVO_PACKAGE_ARCHITECTURE": "arm64",
      "CMAKE_C_COMPILER_LAUNCHER": "ccache",
      "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
    },
    "linux": {
      "CMAKE_PREFIX_PATH": "/home/<user>/vcpkg/installed/x64-linux;/home/<user>/Qt/6.11.2/gcc_64;/usr/local",
      "RAVO_PACKAGE_RUNTIME_SEARCH_PATHS": "/home/<user>/vcpkg/installed/x64-linux/lib;/home/<user>/Qt/6.11.2/gcc_64/lib;/usr/local/lib;/usr/local/lib64",
      "RAVO_PACKAGE_ARCHITECTURE": "x86_64",
      "RAVO_PACKAGE_APPIMAGE_TOOL": "appimagetool",
      "RAVO_PACKAGE_DEB_TOOL": "dpkg-deb",
      "RAVO_PACKAGE_DEB_ARCHITECTURE": "amd64",
      "CMAKE_C_COMPILER_LAUNCHER": "ccache",
      "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
    },
    "win": {
      "CMAKE_TOOLCHAIN_FILE": "C:/Users/<user>/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "CMAKE_PREFIX_PATH": "C:/Users/<user>/vcpkg/installed/x64-windows;C:/Users/<user>/Qt/6.11.2/msvc2022_64",
      "RAVO_PACKAGE_RUNTIME_SEARCH_PATHS": "C:/Users/<user>/vcpkg/installed/x64-windows/bin;C:/Users/<user>/Qt/6.11.2/msvc2022_64/bin;C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Redist/MSVC/<version>/x64/Microsoft.VC143.CRT",
      "RAVO_PACKAGE_ARCHITECTURE": "x86_64",
      "CMAKE_C_COMPILER_LAUNCHER": "ccache",
      "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
    }
  },
  "depsMode": "pinned",
  "depsManualPath": {
    "Exiv2": "",
    "LibJpegTurbo": "",
    "LibRaw": "",
    "RawSpeed": "",
    "GeoControls": "",
    "LensFun": "",
    "LibTIFF": "",
    "LittleCMS": ""
  },
  "dependencies": {
    "Exiv2": {
      "remote": "https://github.com/Exiv2/exiv2.git",
      "commit": "9ff49152c283ac99ee0f39672b426df6bf6109a7",
      "repoName": "exiv2"
    },
    "LibJpegTurbo": {
      "remote": "https://github.com/libjpeg-turbo/libjpeg-turbo.git",
      "commit": "1157d37cfab977f8f7f8344aededdfd951222c89",
      "repoName": "libjpeg-turbo"
    },
    "LibRaw": {
      "remote": "https://github.com/LibRaw/LibRaw.git",
      "commit": "df226ea4178ccd74245f4f13c23adddfa01411c9",
      "repoName": "LibRaw"
    },
    "RawSpeed": {
      "remote": "https://github.com/darktable-org/rawspeed.git",
      "commit": "c835b05aecfacb7343f7c424abd620aa12116c3f",
      "repoName": "rawspeed"
    },
    "GeoControls": {
      "remote": "git@github.com:NorthBoundWisdom/GeoControls.git",
      "commit": "76481057a71ef9fbce1a9eb332732185a954b69f",
      "repoName": "GeoControls"
    },
    "LensFun": {
      "remote": "https://github.com/lensfun/lensfun.git",
      "commit": "23e8cb8050d680c7a293edb3d48b600754665f05",
      "repoName": "lensfun"
    },
    "LibTIFF": {
      "remote": "https://gitlab.com/libtiff/libtiff.git",
      "commit": "dd0ed2c6198fb8fe736ec0329d24a50cfbb2f2ae",
      "repoName": "libtiff"
    },
    "LittleCMS": {
      "remote": "https://github.com/mm2/Little-CMS.git",
      "commit": "cb35a0c1df796fcad01fd5804e5eea4b93379731",
      "repoName": "Little-CMS"
    }
  }
}
